{
  "name": "sqa-homework-arslan-zahid",
  "version": "1.0.0",
  "description": "QA take-home: automated suite + AI-response validation for the pre-login agent at ask.permission.ai",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node scripts/run-suite.mjs",
    "test:pw": "playwright test",
    "test:mobile": "playwright test --project=mobile",
    "test:eval": "python -m pytest evals -q",
    "report": "playwright show-report artifacts/report",
    "typecheck": "tsc --noEmit",
    "ux:walkthrough": "tsx scripts/ux-walkthrough.ts"
  },
  "author": "Arslan Zahid",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
